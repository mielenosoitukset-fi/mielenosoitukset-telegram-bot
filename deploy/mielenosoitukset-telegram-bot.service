[Unit]
Description=Telegram bot for mielenosoitukset.fi demo notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/mielenosoitukset-telegram-bot
EnvironmentFile=/var/www/mielenosoitukset-telegram-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/mielenosoitukset-telegram-bot/.venv/bin/mielenosoitukset-bot
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/mielenosoitukset-telegram-bot/data

[Install]
WantedBy=multi-user.target
